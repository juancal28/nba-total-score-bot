# Funded Polygon EOA private key. Export from Polymarket (Settings -> Export Private Key)
# if your account is the email-login flavor, or use any wallet's raw hex key.
# No 0x prefix. The SDK derives API key/secret/passphrase server-side from this.
NPB_WALLET__PRIVATE_KEY=

# SportRadar API key (trial tier = free; push streaming requires Realtime contract).
NPB_SPORTRADAR__API_KEY=

# Optional logging filter (default: nba_poly_bot=info).
RUST_LOG=nba_poly_bot=info
